# ── Scraping ───────────────────────────────────────────────
# simple = быстрый httpx (стандарт — используйте это)
# camoufox = stealth browser (включить только если блокируют)
SCRAPING_MODE=simple

# Camoufox включается автоматически для этих источников:
CAMOUFOX_SOURCES=glassdoor,linkedin,indeed,bosszp

# ── AI ─────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Школьные ключи (раскомментировать если доступны):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_PROVIDER=azure
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=

# ── Database ───────────────────────────────────────────────
# Для MVP/тестов: бесплатный Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx-yyy-123.eu-central-1.aws.neon.tech/fremtidsbarometer?sslmode=require

# Для локальной разработки с Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fremtidsbarometer

# ── Сервисы ────────────────────────────────────────────────
COLLECTOR_URL=http://localhost:8001/collect
VITE_API_URL=http://localhost:8000

# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Supabase (опционально, для персистентного состояния) ───
SUPABASE_URL=
SUPABASE_KEY=

# ── Официальные API-ключи (все бесплатные) ────────────────
BLS_API_KEY=
GITHUB_TOKEN=
