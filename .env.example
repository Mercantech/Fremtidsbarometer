# ── Scraping ───────────────────────────────────────────────
SCRAPING_MODE=simple
CAMOUFOX_SOURCES=glassdoor,linkedin,indeed,bosszp

# ── AI ─────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Database (sættes automatisk i Docker; kun til lokal uden compose) ──
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fremtidsbarometer

POSTGRES_USER=fremtids_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fremtids_db

# ── API / Admin ────────────────────────────────────────────
ADMIN_API_KEY=change-me-admin
VITE_ADMIN_API_KEY=change-me-admin
# Tom = same-origin via nginx /api proxy (Dokploy)
VITE_API_URL=
ALLOWED_ORIGINS=https://fremtidsbarometer.mercantec.tech,http://localhost:5173,http://localhost:3000

# ── Traefik (Dokploy) ──────────────────────────────────────
TRAEFIK_HOST=fremtidsbarometer.mercantec.tech
TRAEFIK_ROUTER=fremtidsbarometer
TRAEFIK_ENTRYPOINTS=web

# ── Øvrige ─────────────────────────────────────────────────
COLLECTOR_URL=http://localhost:8001/collect
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_URL=
SUPABASE_KEY=
BLS_API_KEY=
GITHUB_TOKEN=
